# .editorconfig
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 2
max_line_length = 100

[*.{html,yml,yaml,json}]
indent_size = 2

[pom.xml]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf